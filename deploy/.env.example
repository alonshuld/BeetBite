# Production environment for the EC2 host, read by docker-compose.prod.yml.
#
# With Terraform (infra/terraform/production) this file is NOT edited by hand:
# /opt/beetbite/render-env.sh rebuilds /opt/beetbite/.env from SSM Parameter
# Store. This template documents the keys, and is the starting point when
# building the host by hand. Never commit the real file.

APP_DOMAIN=app.yourcompany.co.il
ACME_EMAIL=ops@yourcompany.co.il

# Set by deploy.sh on every rollout: sha-<full commit sha>
IMAGE_TAG=

# Hex/alphanumeric password (openssl rand -hex 24) so it needs no URL-encoding.
DATABASE_URL=postgresql://beetbite_app:<password>@<rds-endpoint>:5432/beetbite?sslmode=require

# openssl rand -base64 48. The backend refuses to start in production if under 32 chars.
JWT_SECRET=
ADMIN_USERNAME=admin
# Creates the admin on the first start against an empty database only.
ADMIN_PASSWORD=

# Nightly pg_dump target (backup.sh) and its optional heartbeat URL.
BACKUP_BUCKET=
BACKUP_REGION=eu-central-1
BACKUP_PING_URL=
