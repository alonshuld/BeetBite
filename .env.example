# Copy to .env and fill in before running `docker compose up` / `pnpm infra:up`.
# .env is gitignored; this file is the committed template.

# --- Database ---------------------------------------------------------------
DB_USER=pgUser
DB_PASSWORD=change-me
DB_NAME=pgDb

# --- Backend ----------------------------------------------------------------
# Required. Signs every JWT — anyone who knows it can forge an admin token.
# Generate one with: openssl rand -base64 48
# The backend refuses to start in production if this is under 32 chars or looks
# like a placeholder.
JWT_SECRET=

# Required. Bootstraps the single admin account on first start. There is no
# in-app password change, so treat this as the account credential.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Comma-separated CORS origins (production only)
# ALLOWED_ORIGINS=https://beetbite.example.com
# Token TTL (default 24h)
# JWT_EXPIRES_IN=24h
# Set to "true" to load demo data. DESTRUCTIVE: wipes every business table
# first. Never set this against a database holding real records.
# SEED_MOCK_DATA=false
