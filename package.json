{
  "name": "BeetBite",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm -r test",
    "dev": "pnpm -r dev",
    "dev:demo": "docker compose --profile demo up db-demo -d --force-recreate --wait && export DATABASE_URL=postgresql://demo:demo@localhost:5433/beetbite_demo && pnpm --filter backend exec prisma migrate deploy && SEED_MOCK_DATA=true pnpm --filter backend exec prisma db seed && pnpm dev",
    "dev:demo:down": "docker compose --profile demo rm -sf db-demo",
    "build": "pnpm -r build",
    "lint": "vp lint --fix",
    "lint:check": "vp lint --deny-warnings",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "vp config --no-agent",
    "postinstall": "pnpm --filter backend exec prisma generate",
    "infra:up": "docker compose up db backend -d --build --force-recreate",
    "infra:down": "docker compose stop db backend",
    "test:e2e": "pnpm --filter e2e exec playwright test"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.28.0"
}
