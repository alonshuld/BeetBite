{
  "name": "BeetBite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm -r test",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --workspace-concurrency=1 lint && pnpm -r --workspace-concurrency=1 typecheck",
    "lint:check": "pnpm -r --workspace-concurrency=1 lint:check && pnpm -r --workspace-concurrency=1 typecheck",
    "format": "pnpm -r --workspace-concurrency=1 format",
    "format:check": "pnpm -r --workspace-concurrency=1 format:check",
    "prepare": "pnpm exec husky",
    "postinstall": "pnpm --filter backend exec prisma generate",
    "infra:up": "docker compose up db backend -d --build --force-recreate",
    "infra:down": "docker compose stop db backend",
    "test:e2e": "pnpm --filter e2e exec playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
