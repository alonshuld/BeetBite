# Copy to terraform.tfvars (gitignored) and fill in.

# Names this customer's GitHub environment (prod-<customer>). CD deploys to
# every prod-* environment, so this is all it takes to add the customer to CD.
customer = "rimonim"

alert_emails = ["ops@yourcompany.co.il"]

# Leave domain_name unset for a trial run: the app is then served over plain
# HTTP at http://<elastic_ip> (test data only). Setting it later switches to
# HTTPS: terraform apply, then re-run the first-boot script on the host.
# domain_name   = "yourcompany.co.il"
# app_subdomain = "app"
# acme_email    = "ops@yourcompany.co.il"   # defaults to the first alert email

# Route 53 hosts DNS and Terraform creates the zone. Set create_hosted_zone =
# false if the zone already exists, or manage_dns = false to keep DNS at
# another provider (then add the A record there by hand, using the elastic_ip
# output).
manage_dns         = true
create_hosted_zone = true

# Backups default to Frankfurt so a Tel Aviv outage can't take both copies.
# Use "il-central-1" if client data must stay in Israel.
# backup_region = "eu-central-1"

# Numeric GitHub user IDs whose approval each production deploy waits for
# (curl https://api.github.com/users/<login> | jq .id). Empty = no approval.
# github_deploy_reviewers = [12345678]

# Only when the GHCR packages are private: a classic PAT with read:packages.
# ghcr_username = "your-github-login"
# ghcr_token    = "ghp_..."

# Optional Healthchecks.io ping URL for the nightly backup.
# backup_ping_url = "https://hc-ping.com/<uuid>"
