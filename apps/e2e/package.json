{
  "name": "e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"{tests,fixtures}/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"{tests,fixtures}/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.52.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "bcrypt": "^6.0.0",
    "eslint": "^9.39.3",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
