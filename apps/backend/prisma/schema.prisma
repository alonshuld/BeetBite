generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id   String @id @default(cuid())
  name String @unique

  projects Project[]

  @@map("clients")
}

model Project {
  id              String   @id @default(cuid())
  clientId        String
  name            String   @unique
  estimatedAmount Decimal  @db.Decimal(12, 2)
  finishDate      DateTime @db.Date
  description     String

  client  Client          @relation(fields: [clientId], references: [id])
  reports ProjectReport[]

  @@map("projects")
}

model Subcontractor {
  id   String @id @default(cuid())
  name String @unique

  reports  ProjectReport[]
  payments SubcontractorPayment[]

  @@map("subcontractors")
}

model Corporation {
  id   String @id @default(cuid())
  name String @unique

  payments CorporationPayment[]

  @@map("corporations")
}

model ProjectReport {
  id              String    @id @default(cuid())
  projectId       String
  subcontractorId String
  date            DateTime  @db.Date
  profitMargin    Decimal   @db.Decimal(5, 2)
  income          Decimal   @db.Decimal(12, 2)
  incomeDate      DateTime? @db.Date

  project             Project              @relation(fields: [projectId], references: [id])
  subcontractor       Subcontractor        @relation(fields: [subcontractorId], references: [id])
  corporationPayments CorporationPayment[]

  @@unique([projectId, date])
  @@map("project_reports")
}

model CorporationPayment {
  id              String    @id @default(cuid())
  projectReportId String
  corporationId   String
  amount          Decimal   @db.Decimal(12, 2)
  date            DateTime? @db.Date

  projectReport ProjectReport @relation(fields: [projectReportId], references: [id])
  corporation   Corporation   @relation(fields: [corporationId], references: [id])

  @@map("corporation_payments")
}

model SubcontractorPayment {
  id              String    @id @default(cuid())
  subcontractorId String
  serviceDate     DateTime  @db.Date
  paymentDate     DateTime? @db.Date
  amount          Decimal   @db.Decimal(12, 2)

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])

  @@map("subcontractor_payments")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
