generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Corporation {
  id   String @id @default(cuid())
  name String @unique
}

model Client {
  id   String @id @default(cuid())
  name String @unique
}

model Subcontractor {
  id   String @id @default(cuid())
  name String @unique
}
