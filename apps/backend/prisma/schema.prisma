generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id   String @id @default(cuid())
  name String @unique

  projects           Project[]
  clientAssignments  ProjectClientAssignment[]

  @@map("clients")
}

model Project {
  id String @id @default(cuid())

  /// DERIVED CACHE of the *current* client — the clientAssignment with the
  /// latest effectiveFrom. Written only by ProjectClientAssignmentsService.
  /// NEVER read this to answer a historical question ("who owned this project
  /// in month M?") — use resolveClientsForMonth() instead. See T14.
  clientId        String
  name            String  @unique
  estimatedAmount Decimal @db.Decimal(12, 2)
  description     String
  isDone          Boolean @default(false)

  client                Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reports               ProjectReport[]
  subcontractorPayments SubcontractorPayment[]
  clientAssignments     ProjectClientAssignment[]

  @@map("projects")
}

/// Effective-dated ownership of a project by a client.
/// The client for a report is the assignment with the greatest effectiveFrom
/// that is <= the report's date. Every project has at least one assignment.
model ProjectClientAssignment {
  id            String   @id @default(cuid())
  projectId     String
  clientId      String
  effectiveFrom DateTime @db.Date

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id])

  @@unique([projectId, effectiveFrom])
  @@index([projectId, effectiveFrom])
  @@map("project_client_assignments")
}

model Subcontractor {
  id            String @id @default(cuid())
  name          String @unique
  companyNumber String @unique

  reports  ProjectReport[]
  payments SubcontractorPayment[]

  @@map("subcontractors")
}

model Supplier {
  id   String @id @default(cuid())
  name String @unique

  payments SupplierPayment[]

  @@map("suppliers")
}

model ProjectReport {
  id              String   @id @default(cuid())
  projectId       String
  subcontractorId String
  date            DateTime @db.Date
  profitMargin    Decimal  @db.Decimal(5, 2)

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor    Subcontractor         @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  supplierPayments SupplierPayment[]
  incomeEntries    ProjectReportIncome[]

  @@unique([projectId, date])
  @@map("project_reports")
}

model ProjectReportIncome {
  id              String    @id @default(cuid())
  projectReportId String
  amount          Decimal   @db.Decimal(12, 2)
  incomeDate      DateTime? @db.Date
  tag             String?

  projectReport ProjectReport @relation(fields: [projectReportId], references: [id], onDelete: Cascade)

  @@map("project_report_incomes")
}

model SupplierPayment {
  id              String    @id @default(cuid())
  projectReportId String
  supplierId      String
  amount          Decimal   @db.Decimal(12, 2)
  date            DateTime? @db.Date
  description     String?
  isFuture        Boolean   @default(false)
  vatPercentage   Decimal?  @db.Decimal(5, 2)

  projectReport ProjectReport @relation(fields: [projectReportId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_payments")
}

model SubcontractorPayment {
  id              String   @id @default(cuid())
  subcontractorId String
  projectId       String
  serviceDate     DateTime @db.Date
  amount          Decimal  @db.Decimal(12, 2)
  isPaid          Boolean  @default(false)

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("subcontractor_payments")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model VatRate {
  id             String   @id @default(cuid())
  effectiveMonth DateTime @unique @db.Date
  percentage     Decimal  @db.Decimal(5, 2)
  createdAt      DateTime @default(now())

  @@map("vat_rates")
}

model CompanySettings {
  id            String   @id @default("company-settings")
  name          String?
  description   String?
  companyNumber String?
  phone         String?
  email         String?
  addressStreet String?
  addressCity   String?
  logo          String?
  signature     String?
  updatedAt     DateTime @updatedAt

  @@map("company_settings")
}
